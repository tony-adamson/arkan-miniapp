# Arkan API: шаблон прод-переменных. Скопировать в .env рядом с compose-файлом;
# секреты в git не попадают, значения подставляет деплой (D20).

# dev | test | prod; при ENV=prod LLM_FAKE обязан быть false
ENV=
# Origin фронта: единственный допустимый Origin мутаций (D19)
APP_ORIGIN=

# postgresql+asyncpg://<user>:<password>@<host>:5432/<db>; пул 20 + 20 overflow
DATABASE_URL=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
# redis://<host>:6379/<db> — лимиты и антифрод (REQ-17, fail-open)
REDIS_URL=
# Qdrant и коллекция экспертной базы
QDRANT_URL=
QDRANT_COLLECTION=
# Секрет детерминированного сида карты дня (D3)
DAILY_SECRET=
# Лимит новых раскладов на пользователя за сутки МСК (D18)
SPREADS_PER_DAY=
# true — брать из базы только старшие арканы (D12)
MAJOR_ONLY=

# OpenAI-совместимый провайдер (D1, CON-4); LLM_FAKE только dev/test
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_THINKING=
LLM_TIMEOUT_S=
LLM_PRICE_IN_PER_M=
LLM_PRICE_OUT_PER_M=
LLM_FAKE=
LLM_FAKE_DELAY_MS=

# Каталог ONNX-моделей BGE-M3 и реранкера; в контейнере — /models
MODELS_DIR=
RERANKER_ENABLED=

# Бот: включается фазой 15; TELEGRAM_PROXY — SOCKS-туннель до api.telegram.org
BOT_ENABLED=
BOT_TOKEN=
BOT_USERNAME=
MINI_APP_URL=
TELEGRAM_API_BASE=
TELEGRAM_PROXY=

# Антифрод: регистрации по источнику в час и минимальный интервал обращений
FRAUD_SIGNUPS_PER_SOURCE_HOUR=
FRAUD_MIN_INTERVAL_MS=
